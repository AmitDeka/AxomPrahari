# ==============================================================================
# Root .gitignore - Axom Prahari Monorepo
# ==============================================================================

# --- Environment & Secret Files (Never commit credentials) ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Logs & Debug Dumps ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- Next.js Build Artifacts ---
.next/
frontend/.next/
out/
.vercel/

# --- Backend Ad-Hoc / Scratch / Verification Scripts ---
api/v1/verify*.js
api/v1/inspect*.js
api/v1/migrateFeedbacks.js
api/v1/migrateNotifications.js
api/v1/seedSuperAdmin.js

# --- Android Build, SDK, and Compiler Artifacts ---
.gradle/
app/.gradle/
app/build/
app/app/build/
app/local.properties
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
.kotlin/
app/.kotlin/

# --- IDE & OS Metadata ---
.idea/
app/.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- AI Assistants / Local Agent Artifacts ---
.agents/
app/.agents/
frontend/.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
